# Salin file ini menjadi .env lalu isi key-mu. Jangan pernah upload .env ke GitHub.
# Tulis tanpa tanda kutip dan tanpa spasi setelah tanda =

# Wajib: Gemini (dipakai investigasi dan riset perusahaan lewat Google Search)
GEMINI_API_KEY=isi_api_key_gemini_kamu
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Batas permintaan per menit yang dijaga OpsPilot (turunkan bila masih sering 429)
GEMINI_RPM=8

# Opsional: Groq sebagai cadangan bila kuota Gemini habis (gratis, buat key di console.groq.com)
# GROQ_API_KEY=isi_api_key_groq_kamu
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
# GROQ_RPM=20

# Urutan penyedia untuk investigasi
# LLM_ORDER=gemini,groq

# Autopilot: 1 = aktif, 0 = nonaktif
# OPSPILOT_AUTOPILOT=1
